# Application Settings
PROJECT_NAME="Safety Intelligence & Early Warning System"
ENVIRONMENT=development
DEBUG=False
API_V1_STR=/api/v1
PORT=8000

# Security & Authentication (Generate a secure key in production using: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL & CORS Configuration
# Set FRONTEND_URL to your deployed Netlify domain in production (e.g. https://your-site.netlify.app)
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Managed Database Configuration
# In production on Render/Supabase/Neon/Railway, supply the complete DATABASE_URL:
DATABASE_URL=postgresql://username:password@hostname:5432/safety_intelligence_db

# Alternatively configure individual database parameters (used if DATABASE_URL is not set):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=safety_intelligence_db

# Database development fallback (Set to False in production)
USE_SQLITE_DEV_FALLBACK=True

# Local-only synthetic seed data (production startup never seeds demo data)
SEED_DEMO_DATA=True
